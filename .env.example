# 공용 비밀번호(로그인용) - 실제 값은 반드시 변경하세요
APP_PASSWORD=change-me

# Flask 세션 암호화 키 - 임의의 긴 랜덤 문자열로 변경하세요
SECRET_KEY=change-this-secret-key

# PostgreSQL 접속 정보
DATABASE_URL=postgresql+psycopg://handover:change-db-password@db:5432/handover
POSTGRES_USER=handover
POSTGRES_PASSWORD=change-db-password
POSTGRES_DB=handover

# 세션 유지 시간(분)
SESSION_LIFETIME_MINUTES=480
